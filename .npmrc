# save-exact: every runtime dep is pinned EXACT. A wallet that signs money does
# not float its cryptography (lwk_node, liquidjs-lib, @noble/*, boltz-*), and the
# MCP SDK + zod must stay single-copy — two zod copies break `instanceof` schema
# checks across the gateway/wallet boundary.
#
# `legacy-peer-deps=true` used to live here too, to get past boltz-swaps@0.0.8's
# stale `peerOptional boltz-core@^4.0.5` against the pinned 5.0.0. It is GONE: it
# silenced EVERY future peer conflict repo-wide, not just that one. The scoped
# `overrides` entry in package.json fixes the actual conflict instead, and
# `npm ci` now exits 0 with no advisory (`boltz-swaps -> boltz-core@5.0.0
# deduped`). If a peer conflict ever reappears it should FAIL and be looked at.
save-exact=true
