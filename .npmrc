# Mirrors the engine repo's own .npmrc — the vendored engine's dependency set is
# reproduced here verbatim (unified-MCP spec §2.1).
#
# save-exact: every runtime dep is pinned EXACT. A wallet that signs money does
# not float its cryptography (lwk_node, liquidjs-lib, @noble/*, boltz-*), and the
# MCP SDK + zod must stay single-copy — two zod copies break `instanceof` schema
# checks across the gateway/wallet boundary.
#
# legacy-peer-deps: boltz-swaps@0.0.8 declares `peerOptional boltz-core@^4.0.5`
# while the engine is built and tested against boltz-core@5.0.0. npm only raises
# ERESOLVE when both are ROOT dependencies (i.e. in THIS repo and in CI);
# consumers installing @depixapp/mcp get them nested and resolve cleanly — the
# published @depixapp/sdk@1.2.0 ships the same pair and installs without a flag.
# This file is never included in the published tarball, so it changes nothing for
# consumers; it only keeps `npm ci` green here, on Vercel and in the release job.
save-exact=true
legacy-peer-deps=true
