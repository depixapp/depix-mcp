{
  "name": "@depixapp/mcp",
  "version": "2.2.1",
  "mcpName": "io.github.depixapp/depix-mcp",
  "type": "module",
  "description": "The DePix App MCP server — one MCP, two levels of access: hosted receive-only Pix gateway (22 tools), or local via npx with a non-custodial Liquid wallet that signs on your own machine (49 tools). Checkouts, products, dated charges (cobranças), status reads, support tickets, hold/send/convert, Lightning and gift cards.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "wallet",
    "non-custodial",
    "pix",
    "liquid",
    "bitcoin",
    "lightning",
    "payments",
    "charges",
    "cobranca",
    "depix",
    "stablecoin"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/depixapp/depix-mcp"
  },
  "homepage": "https://depixapp.com",
  "engines": {
    "node": ">=22.4"
  },
  "bin": {
    "depix-mcp": "dist/stdio.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_LICENSES"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/postbuild.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "vendor:engine": "node scripts/vendor-engine.mjs",
    "vendor:check": "node scripts/vendor-engine.mjs --check",
    "guard:hosted": "node scripts/check-hosted-isolation.mjs",
    "licenses": "node scripts/gen-third-party-licenses.mjs",
    "licenses:check": "node scripts/gen-third-party-licenses.mjs --check",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@noble/curves": "2.2.0",
    "@noble/hashes": "2.2.0",
    "@scure/base": "2.2.0",
    "@vulpemventures/secp256k1-zkp": "3.2.1",
    "boltz-core": "5.0.0",
    "boltz-swaps": "0.0.8",
    "hash-wasm": "4.12.0",
    "liquidjs-lib": "6.0.2-liquid.38",
    "lwk_node": "0.18.0",
    "viem": "2.55.11",
    "zod": "3.25.76"
  },
  "overrides": {
    "boltz-swaps": {
      "boltz-core": "5.0.0"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "26.1.1",
    "@vercel/nft": "^0.29.0",
    "@vercel/node": "^5.0.0",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.10"
  }
}
