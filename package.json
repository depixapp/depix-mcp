{
  "name": "@depixapp/mcp",
  "version": "2.8.7",
  "mcpName": "io.github.depixapp/depix-mcp",
  "type": "module",
  "description": "The DePix App MCP server: hosted receive-only Pix gateway (26 tools), or local via npx with a non-custodial Liquid wallet signing on your own machine (62 tools). Checkouts, products, charges, support tickets, send/convert, Lightning and gift cards.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "wallet",
    "non-custodial",
    "pix",
    "liquid",
    "bitcoin",
    "lightning",
    "payments",
    "charges",
    "cobranca",
    "depix",
    "stablecoin"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/depixapp/depix-mcp"
  },
  "homepage": "https://depixapp.com",
  "engines": {
    "node": ">=22.4"
  },
  "bin": {
    "depix-mcp": "dist/stdio.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_LICENSES"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/postbuild.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.wallet-engine.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "guard:hosted": "node scripts/check-hosted-isolation.mjs",
    "smoke": "node scripts/smoke.mjs",
    "licenses": "node scripts/gen-third-party-licenses.mjs",
    "licenses:check": "node scripts/gen-third-party-licenses.mjs --check",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@noble/curves": "2.3.0",
    "@noble/hashes": "2.3.0",
    "@scure/base": "2.2.0",
    "@vulpemventures/secp256k1-zkp": "3.2.1",
    "boltz-core": "5.0.0",
    "boltz-swaps": "0.0.9",
    "hash-wasm": "4.12.0",
    "liquidjs-lib": "6.0.2-liquid.38",
    "lwk_node": "0.19.0",
    "viem": "2.56.1",
    "zod": "3.25.76"
  },
  "overrides": {
    "boltz-swaps": {
      "boltz-core": "5.0.0"
    }
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.3.0",
    "@vercel/nft": "^1.11.0",
    "@vercel/node": "^7.0.0",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
